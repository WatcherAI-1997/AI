# Тамерлан ИИ - Multi-Provider Configuration
# Поддержка множественных AI провайдеров

# ========================================
# AI PROVIDERS - Выберите один или несколько
# ========================================

# 🏆 Anthropic Claude - САМЫЙ УМНЫЙ! (РЕКОМЕНДУЕТСЯ)
# Claude 3.5 Sonnet - лучшая модель для сложных задач
# Получить: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ⚡ Google Gemini - Бесплатный и мощный
# Отличная бесплатная альтернатива
# Получить: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 💻 Ollama - Локальные модели (100% бесплатно)
# Работает на вашем компьютере без интернета
# Установить: https://ollama.ai
# После установки запустите: ollama serve
# Затем загрузите модель: ollama pull llama3.1

# 🔷 OpenAI GPT - Опционально
# Оригинальный ChatGPT
# Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ========================================

# Провайдер по умолчанию: anthropic, gemini, ollama, openai
DEFAULT_AI_PROVIDER=anthropic

# Настройки Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Порт приложения
PORT=5000
