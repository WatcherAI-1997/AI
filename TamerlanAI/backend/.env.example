# TamerlanAI Environment Variables
# Копируйте в .env и заполните значения

# Application
APP_NAME=TamerlanAI
DEBUG=False

# Database
DATABASE_URL=postgresql+asyncpg://tamerlan:tamerlan@localhost:5432/tamerlanai

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Models
MODEL_PATH=./models
DEFAULT_MODEL=tamerlane-gpt

# External APIs (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Logging
LOG_LEVEL=INFO
